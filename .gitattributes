/mvnw text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

# Preserve the exact upstream bytes recorded in the OCR resource manifest.
/src/main/resources/ocr/licenses/*-LICENSE.txt -text whitespace=cr-at-eol
/src/main/resources/ocr/licenses/libtiff-LICENSE.md -text whitespace=-blank-at-eol,-blank-at-eof
/.mvn/wrapper/NOTICE whitespace=-blank-at-eol
