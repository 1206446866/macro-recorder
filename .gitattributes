/mvnw text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

# Preserve the exact upstream bytes recorded in the OCR resource manifest.
/src/main/resources/ocr/licenses/*.txt -text whitespace=cr-at-eol
/src/main/resources/ocr/licenses/libtiff-LICENSE.txt whitespace=-blank-at-eol,-blank-at-eof
/src/main/resources/ocr/licenses/libwebp-LICENSE.txt whitespace=-blank-at-eof
/src/main/resources/ocr/licenses/openjpeg-LICENSE.txt whitespace=-blank-at-eol
/.mvn/wrapper/NOTICE whitespace=-blank-at-eol
